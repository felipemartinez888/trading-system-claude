      }
    },
    "paper_sessions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_exported": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      },
      "description": "event types present in the store up to the chain head and deliberately not exported (research and others), with counts"
    }
  }
}
